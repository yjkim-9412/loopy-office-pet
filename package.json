{
  "name": "loopy-office-pet",
  "version": "0.2.0",
  "description": "잔망루피와 함께하는 데스크톱 업무 펫",
  "author": "yjkim-9412",
  "license": "UNLICENSED",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "@fontsource/nanum-gothic": "^5.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "build": {
    "appId": "com.kyjground.loopyoffice",
    "productName": "Loopy Office",
    "copyright": "Copyright © 2026 yjkim-9412. All rights reserved.",
    "directories": { "output": "release", "buildResources": "assets/brand" },
    "files": ["app/**/*", "ui/*.html", "ui/*.css", "ui/pet.js", "ui/buddy.js", "ui/panel.bundle.js", "ui/fonts.bundle.css", "ui/fonts/**/*", "assets/**/*", "package.json"],
    "extraResources": [{ "from": "build/native", "to": "native" }],
    "win": { "target": ["nsis", "portable"], "icon": "assets/brand/icon.ico" },
    "mac": { "target": "dmg", "icon": "assets/brand/icon.icns", "category": "public.app-category.productivity", "artifactName": "LoopyOffice-${version}-mac-${arch}.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true, "createDesktopShortcut": "always", "createStartMenuShortcut": true,
      "shortcutName": "Loopy Office", "deleteAppDataOnUninstall": false, "installerLanguages": ["ko_KR"], "language": "1042",
      "artifactName": "LoopyOffice-Setup-${version}-${arch}.${ext}" },
    "portable": { "artifactName": "LoopyOffice-Portable-${version}-${arch}.${ext}" },
    "publish": [{ "provider": "generic", "url": "https://loopy-update.invalid/win/" }]
  }
}
